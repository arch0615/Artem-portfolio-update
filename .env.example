# ---------------------------------------------------------------------------
# Inquiry-form email delivery (server-side only — never prefix with VITE_)
# Only used when platformCompliance.allowExternalFormSubmission is true in
# src/data/contact.ts. Check your marketplace's rules before enabling it.
# ---------------------------------------------------------------------------

# Resend API key — https://resend.com/api-keys
RESEND_API_KEY=

# Where contact messages are delivered (comma-separate multiple addresses)
CONTACT_TO_EMAIL=

# Verified sender. Resend's test sender works until you verify a domain,
# but can only deliver to the email address that owns the Resend account.
CONTACT_FROM_EMAIL="Portfolio Contact <onboarding@resend.dev>"

# ---------------------------------------------------------------------------
# Optional (public, bundled into the frontend)
# ---------------------------------------------------------------------------

# Override the endpoint the contact form posts to, e.g. a Formspree form URL.
# Defaults to /api/contact.
VITE_CONTACT_ENDPOINT=
